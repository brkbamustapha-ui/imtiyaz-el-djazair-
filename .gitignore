# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files — NEVER commit real secrets
.env
.env*.local
.env.production

# database (local SQLite dev database)
/prisma/*.db
/prisma/*.db-journal
/prisma/dev.db*

# runtime media: Media Library uploads and brand artwork dropped in after build
/storage/media/*
!/storage/media/.gitkeep
!/storage/media/brand
/storage/media/brand/*
!/storage/media/brand/README.md

# typescript
*.tsbuildinfo

# vercel
.vercel

# form attachments (served only through an authenticated admin route)
/storage/submissions/*
!/storage/submissions/.gitkeep
