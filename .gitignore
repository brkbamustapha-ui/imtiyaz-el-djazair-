# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files — NEVER commit real secrets
.env
.env*.local
.env.production

# database (local SQLite dev database)
/prisma/*.db
/prisma/*.db-journal
/prisma/dev.db*

# user uploads (managed via the admin Media Library at runtime)
/public/uploads/*
!/public/uploads/.gitkeep

# typescript
*.tsbuildinfo

# vercel
.vercel

# form attachments (served only through an authenticated admin route)
/storage/submissions/*
!/storage/submissions/.gitkeep
